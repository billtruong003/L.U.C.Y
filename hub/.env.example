# Lucy Hub env. Copy -> .env, đặt TRÊN máy chạy hub. 🔐 không commit.
LUCY_HUB_PASSWORD=          # mật khẩu đăng nhập web (BẮT BUỘC — không đặt thì không vào được)
# LUCY_HUB_PORT=8800

# Tùy chọn (default hợp lý):
# CLAUDE_BIN=claude         # VPS: /root/.local/bin/claude
# LUCY_WORKDIR=~/lucy/workspace
# LUCY_PERSONA=~/lucy/bridge/persona.md
# LUCY_CLAUDE_TIMEOUT=900
