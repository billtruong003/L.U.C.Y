# Lucy — Hermes env. Copy -> .env, điền giá trị thật TRÊN VPS.
# 🔐 KHÔNG paste secret vào chat / không commit .env.
#
# Kiến trúc: THÂN = grok-4.1-fast-reasoning (xAI thẳng) · NÃO = Claude Code qua `!c`.
# Đã bỏ OmniRoute. provider=xai native (đã validate 2026-06-03).

# --- Body model: xAI grok (provider=xai native — đã validate) ---
# config.yaml provider=xai đọc THẲNG biến này. Đặt = xAI API key thật (billed-by-API).
# (KHÔNG dùng OPENAI_API_KEY — provider=custom bỏ qua nó, tự điền "not-needed" → xAI 400.)
XAI_API_KEY=

# --- KHÔNG set ANTHROPIC_* ---
# Hermes provider=xai ⇒ không đi native Anthropic ⇒ không đọc ~/.claude.
# Để trống/không khai báo ANTHROPIC_API_KEY cho chắc. Claude Code tự dùng OAuth riêng
# (~/.claude/.credentials.json) khi Hermes chạy `claude -p` — không liên quan env này.

# --- Telegram (line riêng Lucy) ---
TELEGRAM_BOT_TOKEN=
# Khóa chỉ Bill được dùng:
TELEGRAM_ALLOWED_USER_IDS=

# --- Web dashboard (tùy chọn, khi mở qua IP public) ---
# hermes dashboard --host 0.0.0.0 → tự bật OAuth gate (Nous Portal). BẮT BUỘC HTTPS+firewall.
# HERMES_DASHBOARD_OAUTH_CLIENT_ID=agent:...
# HERMES_DASHBOARD_PUBLIC_URL=https://lucy.example.com
