# Lucy — Hermes env. Copy -> .env, điền giá trị thật TRÊN VPS/BOX.
# 🔐 KHÔNG paste secret vào chat / không commit .env.
#
# Body brain = MISTRAL FREE (provider=custom). Key Mistral KHÔNG đi qua .env này —
# custom đọc model.api_key trong config. Đặt key TRÊN BOX (ghi ~/.hermes/config.yaml, ko commit):
#     hermes config set model.api_key <mistral-key>
# Lấy key free: https://console.mistral.ai  (1B token/tháng)

# --- Telegram (line riêng Lucy) ---
TELEGRAM_BOT_TOKEN=
# Khóa chỉ Bill được dùng:
TELEGRAM_ALLOWED_USER_IDS=

# --- (Fallback) grok qua xAI: nếu đổi config về provider=xai thì set key dưới ---
# XAI_API_KEY=

# --- KHÔNG set ANTHROPIC_* --- (Claude Code dùng OAuth riêng ~/.claude khi em chạy `claude -p`)

# --- Web dashboard (tùy chọn, khi mở qua tunnel) ---
# LUCY_INGEST_KEY=<random>   # bảo vệ inject-API của lucy-hub plugin
