# Lucy — Hermes env (qua OmniRoute). Copy -> .env, điền giá trị thật TRÊN VPS.
# 🔐 KHÔNG paste secret vào chat / không commit .env.

# --- LLM routing qua OmniRoute (self-host) ---
# Hermes provider=anthropic POST {ANTHROPIC_BASE_URL}/v1/messages -> OmniRoute
# route tới provider theo model prefix (vd xai/grok-4.3 -> xAI).
# Instance đang REQUIRE_API_KEY=false nên key dưới chỉ là token "đi qua cổng".
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_API_KEY=omniroute-local

# Provider key thật KHÔNG để ở đây — nằm trong OmniRoute (connection xai),
# add 1 lần qua dashboard/API. Brain hiện tại: xai/grok-4.3.
# (file key local trên VPS: /opt/omniroute/.xai_key — nhớ rotate key đã lộ ở chat.)

# --- Telegram (line riêng Lucy) ---
TELEGRAM_BOT_TOKEN=
# Khóa chỉ Bill được dùng:
TELEGRAM_ALLOWED_USER_IDS=

# --- OmniRoute admin (để quản trị/route, KHÔNG bắt buộc cho inference) ---
# Dashboard: http://localhost:20128  (login bằng INITIAL_PASSWORD trong /opt/omniroute/.env)
OMNIROUTE_BASE_URL=http://localhost:20128
