# Lucy — environment template. Copy to .env on the VPS (nano .env). NEVER commit .env or paste it in chat.

# --- Model / brain (Hermes) ---
ANTHROPIC_API_KEY=            # Claude cho việc khó
OPENROUTER_API_KEY=           # model rẻ / linh hoạt (tùy chọn)
HERMES_PRIMARY_PROVIDER=      # anthropic | openrouter | nous

# --- Messaging ---
TELEGRAM_BOT_TOKEN=           # @BotFather
TELEGRAM_OWNER_USER_ID=       # khóa cứng: chỉ Bill ra lệnh được
# (Lucy KHÔNG connect Discord trực tiếp — đi qua bridge → radiant-bot/Aki. Không cần Discord token riêng.)

# --- Voice (Telegram only — FREE, no GPU, đa ngôn ngữ gồm VN) ---
STT_PROVIDER=                 # hermes-builtin | whisper-cloud | faster-whisper-local
TTS_BASE=melotts              # base: MeloTTS family self-host CPU (EN/JA/... + VN fork)
TTS_VI_MODEL=nmcuong/MeloTTS-Vietnamese   # model tiếng Việt cho MeloTTS
# Optional nâng cấp:
TTS_CLONE=                    # vieneu-tts (VN + clone giọng cute, CPU) — bật khi muốn
HF_TOKEN=                     # free HF token (nếu xài HF Space anime JP optional)
HF_TTS_SPACE=                 # vd Kit-Lemonfoot/Hololive-Style-Bert-VITS2 (optional, cho vui)
LUCY_VOICE_ID=                # speaker id cố định cho giọng Lucy

# --- Bridge → radiant-bot ---
RADIANT_BOT_API_URL=          # vd http://14.225.255.73:3030
RADIANT_BOT_HMAC_SECRET=      # dùng chung với radiant-bot control API

# --- Research ---
RESEARCH_SCHEDULE_CRON=       # vd "0 7,19 * * *" (chưa chốt giờ)
RESEARCH_OUTPUT_DIR=./research
