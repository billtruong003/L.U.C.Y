# Lucy Bridge env. Copy -> .env, điền TRÊN VPS. 🔐 không commit .env.
TELEGRAM_BOT_TOKEN=
LUCY_ALLOWED_USER_ID=          # user id Telegram của chủ nhân (khóa chỉ mình chủ nhân). /id để lấy.

# Tùy chọn (có default hợp lý):
# CLAUDE_BIN=claude            # đường dẫn claude CLI (mặc định 'claude'; VPS: /root/.local/bin/claude)
# LUCY_WORKDIR=~/lucy-workspace
# LUCY_PERSONA=~/lucy/bridge/persona.md
# LUCY_CLAUDE_TIMEOUT=900
